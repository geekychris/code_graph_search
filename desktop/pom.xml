<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.codegraph</groupId>
        <artifactId>code-graph-search</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>desktop</artifactId>
    <name>Code Graph Search - Desktop (JavaFX WebView)</name>
    <description>
        Java-native desktop wrapper: spawns the existing REST + web UI
        on a random loopback port and shows it in a JavaFX WebView so
        users get a real native window instead of a browser tab. Same
        wrapping pattern as history_viewer's hv-app but implemented in
        Java (no Go dependency) so this stays a pure-JDK stack.
        Packaged as a self-contained .app via jpackage — end users
        need nothing on PATH.
    </description>

    <properties>
        <javafx.version>21.0.5</javafx.version>
    </properties>

    <dependencies>
        <!-- Depend on the individual internal modules, NOT on the `app`
             fat JAR. Depending on the shaded `app` artifact would try
             to re-shade an already-shaded JAR, which corrupts Lucene's
             multi-release JAR structure (Java 21 MemorySegmentIndexInput
             lives under META-INF/versions/21/ and its ServiceLoader
             registration gets lost). Matches app/pom.xml's layout. -->
        <dependency>
            <groupId>com.codegraph</groupId>
            <artifactId>core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.codegraph</groupId>
            <artifactId>parser</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.codegraph</groupId>
            <artifactId>indexer</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.codegraph</groupId>
            <artifactId>watcher</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.codegraph</groupId>
            <artifactId>mcp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.codegraph</groupId>
            <artifactId>rest</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.codegraph</groupId>
            <artifactId>ui</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- app module is source-level dep only (we call
             com.codegraph.app.Main.main); avoid the shaded fat JAR by
             excluding transitives. -->
        <dependency>
            <groupId>com.codegraph</groupId>
            <artifactId>app</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
            <classifier>mac-aarch64</classifier>
        </dependency>

        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Build an executable fat JAR — same pattern as app/ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <finalName>code-graph-search-desktop</finalName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <!-- Launcher is a plain (non-Application) trampoline so
                                         `java -jar` works. JavaFX rejects `java -jar` when the
                                         Main-Class itself extends Application. -->
                                    <mainClass>com.codegraph.desktop.Launcher</mainClass>
                                    <manifestEntries>
                                        <!-- Preserves META-INF/versions/21/ Lucene provider
                                             classes — otherwise Java 21 MemorySegmentIndex
                                             fails to load with LinkageError. -->
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
